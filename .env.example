# ATI 开发环境模板。复制为 .env 后填写，不要提交真实值。
TZ=Asia/Shanghai
ATI_ENV=development
ATI_LOG_LEVEL=INFO

# Fuyao 主数据源
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=
FUYAO_TIMEOUT_SECONDS=20
FUYAO_MAX_RETRIES=3
FUYAO_REQUEST_GAP_SECONDS=0.2

# 本地存储
ATI_DATABASE_URL=sqlite:///data/ati.db
ATI_RAW_DATA_DIR=data/raw

# 东方财富仅用于影子验证；设为 true 前先核对接口授权和限流。
EASTMONEY_SHADOW_ENABLED=false
EASTMONEY_TIMEOUT_SECONDS=15
EASTMONEY_REQUEST_GAP_SECONDS=0.5

# ATI 运行参数
ATI_SIGNAL_TIMEZONE=Asia/Shanghai
ATI_SIGNAL_TIMES=14:30,14:35,14:40,14:45,14:50
ATI_MAX_CANDIDATES=5
ATI_PRIMARY_HORIZON_TRADING_DAYS=3
ATI_AUX_HORIZONS=1,5
ATI_MAX_BACKFILL_MINUTES=30
