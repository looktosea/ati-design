{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ati.local/schemas/factor-value.schema.json",
  "title": "ATI factor value",
  "type": "object",
  "required": ["factor_id", "factor_version", "security_id", "decision_cutoff", "validity"],
  "properties": {
    "factor_id": {"type": "string", "pattern": "^[MSFIPR][0-9]{2}$"},
    "factor_version": {"type": "string"},
    "security_id": {"type": ["string", "null"]},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "raw_value": {},
    "transformed_value": {},
    "validity": {"enum": ["VALID", "INSUFFICIENT_HISTORY", "MISSING", "STALE", "NOT_APPLICABLE", "CONFLICTED", "SOURCE_CHANGED"]},
    "missing_reason": {"type": ["string", "null"]},
    "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "data_asof": {"type": ["string", "null"], "format": "date-time"},
    "source_batch_ids": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
